<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.logazac.mapper.DetectionRuleMapper">

    <select id="findDetNoByRuleType"
            resultType="java.lang.Integer">

        SELECT DET_NO
        FROM DETECTION_RULES
        WHERE DET_RULE_TYPE = #{ruleType}
          AND USE_YN = 'Y'

    </select>

</mapper>